<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fog-ids</groupId>
  <artifactId>simulation</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lib.dir>${project.basedir}/lib</lib.dir>
  </properties>

  <!--
    iFogSim2 ships as an Eclipse project with vendored jars and no build file.
    CloudSim itself is included as source under org.cloudbus.cloudsim, so it
    compiles directly with our own classes. The jars below are iFogSim2's
    third-party dependencies, referenced with system scope so the build works
    fully offline against the vendored copies rather than pulling from
    Maven Central, which is not reachable from this environment.
  -->
  <dependencies>
    <dependency>
      <groupId>vendored</groupId><artifactId>commons-io</artifactId><version>2.17.0</version>
      <scope>system</scope><systemPath>${lib.dir}/commons-io-2.17.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>commons-lang3</artifactId><version>3.17.0</version>
      <scope>system</scope><systemPath>${lib.dir}/commons-lang3-3.17.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>commons-math3</artifactId><version>3.5</version>
      <scope>system</scope><systemPath>${lib.dir}/commons-math3-3.5.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>commons-net</artifactId><version>3.11.1</version>
      <scope>system</scope><systemPath>${lib.dir}/commons-net-3.11.1.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>guava</artifactId><version>18.0</version>
      <scope>system</scope><systemPath>${lib.dir}/guava-18.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>json-simple</artifactId><version>1.1.1</version>
      <scope>system</scope><systemPath>${lib.dir}/json-simple-1.1.1.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>opencsv</artifactId><version>5.9</version>
      <scope>system</scope><systemPath>${lib.dir}/opencsv-5.9.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>uncommons-maths</artifactId><version>1.2.3</version>
      <scope>system</scope><systemPath>${lib.dir}/uncommons-maths-1.2.3.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>vendored</groupId><artifactId>geoip2</artifactId><version>4.2.0</version>
      <scope>system</scope><systemPath>${lib.dir}/geoip2-4.2.0.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>fog-ids-simulation</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <source>11</source>
          <target>11</target>
          <!-- iFogSim2's bundled source has some unchecked/deprecation warnings; not build-breaking -->
          <showWarnings>false</showWarnings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
    </plugins>
  </build>
</project>
